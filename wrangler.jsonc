// Cloudflare Worker com static assets (NÃO é o Pages). Publica a pasta dist/ do `vite build`.
// worker.js = fallback de SPA (telas -> index.html; arquivo inexistente -> 404), igual ao vercel.json.
// Headers de cache: public/_headers (copiado para dist/ no build).
// Deploy: `npm run cf:deploy` (precisa de `wrangler login` ou CLOUDFLARE_API_TOKEN na SUA máquina).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopefin-app",
  "main": "worker.js",
  // Domínios (o DNS de hopefin.com.br está nesta conta da Cloudflare). O mesmo worker
  // serve o app e o painel; admin.hopefin.com.br abre direto o /admin (redirect no main.jsx).
  "routes": [
    { "pattern": "app.hopefin.com.br", "custom_domain": true },
    { "pattern": "admin.hopefin.com.br", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
