# Copie para .env e preencha com as chaves do SEU projeto Supabase
# (Supabase Dashboard -> Settings -> API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key-aqui

# NUNCA coloque a service_role key aqui nem em qualquer arquivo do front.

# Observabilidade (opcional; o app roda sem elas). Todas são chaves PÚBLICAS de front.
# Sentry: só monitoramento de erros (sem replay). PostHog: analytics de produto
# (sem replay/autocapture) e só carrega após o usuário aceitar os cookies.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
